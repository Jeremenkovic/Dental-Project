# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/dental.db
REDIS_URL=redis://localhost:6379/0
STORAGE_PATH=./data/scans

# ── Worker ────────────────────────────────────────────────────────────────────
# Set DEMO_MODE=true to bypass reconstruction and use synthetic arch (no GPU)
DEMO_MODE=false

# Path to gaussian-splatting repo clone (only needed if DEMO_MODE=false and GPU available)
# GAUSSIAN_SPLATTING_DIR=/opt/dental3d/gaussian-splatting

# 3DGS training iterations (7000 = full quality, 3000 = faster dev)
GS_TRAIN_ITERATIONS=7000

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
